# Login - required to sign in at /login and to view the dashboard/API.
# If left unset, a random key is generated each time the server starts and
# printed to its console - fine for a quick local demo, but set a real value
# here for anything you'll restart more than once (otherwise every restart
# logs everyone out, and detection_client.py needs updating to match).
ADMIN_API_KEY=nd0506

# Optional read-only key. Anyone who signs in at /login with THIS key
# instead of ADMIN_API_KEY gets a viewer session - they can watch the live
# dashboard (counts, charts, alerts, SMS log) but can't change any setting,
# run demo controls, or trigger the panic button. Leave unset to disable
# viewer logins entirely (only ADMIN_API_KEY will work, same as before).
VIEWER_API_KEY=nd0506

# Signs the session cookie /login relies on. If left unset, a random one is
# generated each run (sessions won't survive a restart). Set a real value
# before deploying anywhere besides your own machine.
SECRET_KEY=nd0506

# Signs device tokens (see /api/device-token, and DEVICE_TOKEN below) -
# optional, defaults to SECRET_KEY above if unset. Only set this separately
# if you want device tokens to keep working across a SECRET_KEY rotation
# (which logs out every browser session) without also needing to reissue
# every device's token.
JWT_SECRET=

# How long (in seconds) a login stays valid before you have to sign in
# again. Default is 12 hours (43200). Without this, a login would never
# expire on its own - only /logout clears it.
SESSION_LIFETIME_SECONDS=43200

# Maximum request body size, in MB. Protects against oversized/garbage
# payloads to /api/update. Default 8MB is generous for a single JPEG frame.
MAX_CONTENT_LENGTH_MB=8

# Hard ceiling on a single /api/update count reading. No realistic
# single-camera crowd exceeds a few thousand - this stops a malformed or
# malicious request from injecting an absurd number that would instantly
# force CRITICAL and trigger a real SMS.
MAX_REASONABLE_COUNT=5000

# Row cap on a single CSV export (/api/export/*.csv). A safety net against
# an unbounded download on a database that's been running for a very long
# time - raise it if you genuinely need more than 50,000 rows in one file.
EXPORT_ROW_LIMIT=50000

# ---------------------------------------------------------------------
# detection_client.py settings (multi-camera + zone density).
# Run one detection_client.py process per physical camera; give each its
# own .env (or exported environment) with a distinct CAMERA_ID.
# ---------------------------------------------------------------------

# Which camera this detection_client.py instance represents. Every
# /api/update it sends is tagged with this ID, so the server (and
# dashboard's camera switcher) can track it separately from any other
# cameras posting to the same server. Defaults to "cam1" if unset.
CAMERA_ID=cam1

# Optional human-readable label shown on the dashboard (e.g. "Main Gate").
# Sent once on the first update; if left unset, the camera ID itself is
# used as the label until you set one from Alerts & Controls.
CAMERA_LABEL=

# The camera feed this instance reads. A phone IP-camera app's URL, or 0
# for a laptop's built-in webcam. Defaults to the sample phone-cam URL in
# detection_client.py if unset.
VIDEO_URL=http://192.168.31.227:8080/video

# Zone/density grid size for this camera. Divides the frame into
# ZONE_ROWS x ZONE_COLS cells and reports a per-cell headcount alongside
# the total, so a local crush near one exit isn't hidden inside a
# venue-wide average. Set both to 1 to disable and report only the total.
ZONE_ROWS=3
ZONE_COLS=3
